# systemd unit for the live bot on EC2. Installed by deploy/setup_ec2.sh; see deploy/README.md.
# The mode (paper | live) and the model come from config.yaml `live:`, so every change is a commit.
[Unit]
Description=MiniMax Roostoo bot (python -m src.live.runner run)
After=network-online.target time-sync.target
Wants=network-online.target
# a crash loop must not hammer the exchange: at most 10 starts in 10 minutes, then systemd gives up
StartLimitIntervalSec=600
StartLimitBurst=10

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/minimax
Environment=MM_HOST=ec2
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/minimax/.venv/bin/python -m src.live.runner run
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
