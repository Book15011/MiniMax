# systemd unit for the live bot on EC2. Installed by deploy/setup_ec2.sh; see deploy/README.md.
# The mode (paper | live) and the model come from config.yaml `live:`, so every change is a commit.
[Unit]
Description=MiniMax Roostoo bot (python -m src.live.runner run)
After=network-online.target time-sync.target
Wants=network-online.target
# Never give up restarting: a start fails while Roostoo's API is down (the bot reads exchangeInfo at startup), and a
# limit of N starts in M minutes would leave the bot dead after an outage longer than that. One start a minute is
# a handful of public calls, far below the rate limit.
StartLimitIntervalSec=0

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/minimax
Environment=MM_HOST=ec2
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/minimax/.venv/bin/python -m src.live.runner run
Restart=always
RestartSec=60

[Install]
WantedBy=multi-user.target
